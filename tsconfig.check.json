{
    // Typechecks the test tree, which tsconfig.json excludes. Run with `npm run typecheck:tests`.
    // Extends the production config so the target, strictness, and module resolution stay identical:
    // a test that relies on a runtime API the project's target does not promise (Array.prototype
    // .findLast is ES2023, this project compiles for ES2022) fails here and passes in Vitest.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false
    },
    "include": ["src/**/*.ts", "test/**/*.ts"],
    "exclude": ["node_modules", "dist", ".state"]
}
